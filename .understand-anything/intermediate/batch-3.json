      "name": "file-watcher.js",
      "filePath": "lib/cache/file-watcher.js",
      "summary": "Provides the FileWatcher EventEmitter class that watches fscripts.md for filesystem changes and automatically invalidates related cache entries with debounced change handling.",
      "tags": ["cache", "event-handler", "service"],
      "complexity": "complex"
    },
    {
      "id": "class:lib/cache/file-watcher.js:FileWatcher",
      "type": "class",
      "name": "FileWatcher",
      "filePath": "lib/cache/file-watcher.js",
      "lineRange": [15, 191],
      "summary": "EventEmitter subclass that uses Node's fs.watch to monitor files, debounces change events, and delegates invalidation to the CacheManager when a watched file is modified or renamed.",
      "tags": ["cache", "event-handler", "service"],
      "complexity": "complex",
      "languageNotes": "Extends EventEmitter; uses unref() on timers and watchers so the process can exit naturally even when watches are active."
    },
    {
      "id": "file:lib/cache/index.js",
      "type": "file",
      "name": "index.js",
      "filePath": "lib/cache/index.js",
      "summary": "Core cache module exporting the CacheManager class (LRU-style in-memory cache with TTL, file-mtime validation, hit/miss tracking, and EventEmitter events) plus getCache/resetCache singleton factory helpers.",
      "tags": ["cache", "service", "singleton"],
      "complexity": "complex"
    },
    {
      "id": "class:lib/cache/index.js:CacheManager",
      "type": "class",
      "name": "CacheManager",
      "filePath": "lib/cache/index.js",
      "lineRange": [37, 393],
      "summary": "EventEmitter-based in-memory cache with configurable TTL, max-size eviction, file mtime invalidation, periodic cleanup, and detailed hit/miss/eviction statistics.",
      "tags": ["cache", "service", "singleton"],
      "complexity": "complex",
      "languageNotes": "Emits named events (hit, miss, set, invalidate, evict, cleanup, clear, destroy) enabling the monitor and watcher subsystems to react without tight coupling."
    },
