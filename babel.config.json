{
  "presets": [
    ["@babel/preset-env", {
      "targets": { "node": "current" },
      "modules": false
    }],
    "@babel/preset-react"
  ],
  "plugins": [
    ["@babel/plugin-transform-runtime", {
      "useESModules": true
    }],
    "@babel/plugin-proposal-export-default-from",
    ["@babel/plugin-proposal-decorators", { "legacy": true }],
    "@babel/plugin-syntax-class-properties"
  ]
}
