{
    "name": "fscr",
    "version": "7.3.1",
    "description": "Runs the fscripts.md file",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "build": "rimraf dist && mkdir -p dist/lib && cp -r lib/. dist/lib && cp index.js dist/index.js",
        "fsr": "node dist/index.js",
        "release": "yarn fsr bump && yarn build",
        "release:publish": "node lib/release/publish.js",
        "start": "run-s build start:run",
        "start:run": "node dist/index.js",
        "watch": "nodemon --watch lib --watch index.js --ext js --exec \"mkdir -p dist/lib && cp -r lib/. dist/lib && cp index.js dist/index.js\" --ignore 'node_modules' -I",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:e2e": "vitest run tests/e2e",
        "test:performance": "vitest run tests/performance"
    },
    "fscripts": {
        "encryptedFiles": [
            "config.json"
        ],
        "ignore-upgrade": [],
        "config": "test.json"
    },
    "staticPath": {
        "source": "lib/auth/index.html",
        "target": "dist/index.html"
    },
    "repository": "https://github.com/agrublev/freedcamp-script-runner.git",
    "private": false,
    "license": "MIT",
    "author": "Angel Grablev <agrublev@gmail.com>",
    "files": [
        "dist",
        "bin"
    ],
    "bin": {
        "fsr": "./bin"
    },
    "dependencies": {
        "boxen": "^8.0.1",
        "chalk": "^4.1.2",
        "conf": "^15.0.2",
        "cross-spawn": "^7.0.1",
        "detect-indent": "^7.0.2",
        "enquirer": "^2.3.4",
        "fc-filepick": "^1.3.0",
        "fs-extra": "^11.3.2",
        "git-changed-files": "^1.0.0",
        "git-release-notes": "^5.0.0",
        "git-state": "^4.1.0",
        "inquirer": "^12.9.6",
        "json-colorz": "^0.2.7",
        "markdown-toc": "^1.2.0",
        "marked": "^16.3.0",
        "moment-mini": "^2.24.0",
        "open": "^10.2.0",
        "pretty-ms": "^9.3.0",
        "require-from-string": "^2.0.2",
        "server-destroy": "^1.0.1",
        "simple-git": "^3.28.0",
        "sort-object-keys": "^2.0.0",
        "staged-git-files": "^1.2.0",
        "term-size": "^4.0.0",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^3.2.4",
        "nodemon": "^3.1.10",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "chalk": "^4.1.2"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
