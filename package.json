{
    "name": "fscr",
    "version": "7.7.1",
    "description": "Runs the fscripts.md file",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "find-scripts-in-fscripts": "you can find all scripts in fscripts.md",
        "fsr": "bun ./dist/index.js",
        "start": "yarn fsr",
        "test": "vitest run",
        "list": "yarn fsr start",
        "test:coverage": "vitest run --coverage",
        "release": "sh scripts/release.sh"
    },
    "fscripts": {
        "encryptedFiles": [
            "config.json"
        ],
        "ignore-upgrade": [],
        "config": "test.json"
    },
    "repository": "https://github.com/agrublev/freedcamp-script-runner.git",
    "private": false,
    "license": "MIT",
    "author": "Angel Grablev <agrublev@gmail.com>",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "bin"
    ],
    "bin": {
        "fsr": "./bin",
        "fscr": "./bin"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.3.0",
        "boxen": "^9.0.0",
        "chalk": "^6.0.1",
        "cross-spawn": "^7.0.6",
        "fc-filepick": "^2.0.0",
        "fs-extra": "^11.4.1",
        "ink": "^8.0.0",
        "ink-scroll-list": "^0.5.0",
        "inquirer": "^14.2.4",
        "markdown-toc": "^1.2.0",
        "marked": "^18.1.1",
        "moment-mini": "^2.29.4",
        "react": "^19.3.1",
        "simple-git": "^4.0.2",
        "yargs": "^18.2.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.5",
        "esbuild": "^0.28.2",
        "nodemon": "^3.1.14",
        "vitest": "^5.0.5"
    }
}
